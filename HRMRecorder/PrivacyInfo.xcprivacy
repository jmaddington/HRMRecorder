<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App does no cross-app/website tracking. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	  No data is collected by the developer. Heart-rate samples are written
	  only to the on-device SQLite database. The optional Server Sync feature
	  uploads to a server the *user* configures (self-hosted), not to the
	  developer, so it is not declared as developer data collection here.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!--
	  Required-reason API declarations. The app reads/writes its own
	  UserDefaults (no app-group suite shared with other apps), which is
	  reason CA92.1: "Access info from the app itself".
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
